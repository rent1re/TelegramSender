@{
    ViewData["Title"] = "Telegram";
}

<h1>Send to Telegram</h1>

<form method="post" asp-controller="Telegram" asp-action="Send" class="send-form">
    <label class="send-label">Message text:</label>

    <div class="send-row">
        <input type="text"
               name="text"
               placeholder="Message..."
               class="send-input" />

        <button type="submit" class="send-btn" title="Send">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor"
                      d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
            </svg>
            <span>Send</span>
        </button>
    </div>

    @if (ViewBag.Ok == false && ViewBag.Result != null)
    {
        <p class="send-error">@ViewBag.Result</p>
    }
</form>

<style>
    .send-form {
        max-width: 520px;
    }

    .send-label {
        display: block;
        margin-bottom: 8px;
    }

    .send-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .send-input {
        flex: 1;
        padding: 12px 14px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 8px;
    }

    .send-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        font-size: 16px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        background: #229ED9;
        color: #fff;
    }

        .send-btn:hover {
            background: #1b8ec4;
        }

        .send-btn:active {
            background: #187aa8;
        }

    .send-error {
        color: #c0392b;
        margin-top: 10px;
    }
</style>

@if (ViewBag.Ok == true && ViewBag.Result != null)
{
    <hr />
    <p style="color:green">Success</p>
    <pre>@ViewBag.Result</pre>
}